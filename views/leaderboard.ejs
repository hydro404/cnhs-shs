<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> Leaderboards</title>
    <link rel="stylesheet" href="/css/styles.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#181f27] font-[Space_Grotesk] min-h-screen flex items-center justify-center p-4">
    <div class="max-w-2xl w-full bg-[#232b36] rounded-3xl shadow-2xl p-4 md:p-8">
        <div class="flex items-center justify-between mb-6 md:mb-8">
            <div>
                <div class="text-2xl font-bold tracking-tight text-teal-400 md:text-3xl">Leaderboards</div>
                <div class="mt-1 text-sm text-gray-400 md:text-base">Top performers in <%= title %></div>
            </div>
            <div class="text-2xl text-yellow-400 md:text-3xl">&#x1F3C6;</div>
        </div>
        <div class="mb-6 md:mb-8" id="strandFilters">
            <select id="strandSelect" class="w-full md:w-auto px-3 py-2 rounded-lg bg-[#232b36] text-gray-300 font-semibold text-sm md:text-base focus:outline-none focus:ring-2 focus:ring-teal-400 border">
                <option value="" <%= !selectedStrand ? 'selected' : '' %>>All Strands</option>
                <%
                // Map strand names to emoji icons
                function getStrandIcon(strand) {
                    if (/EIM/i.test(strand)) return '⚡';
                    if (/HE/i.test(strand)) return '🍴';
                    if (/CSS/i.test(strand)) return '💻';
                    if (/GAS/i.test(strand)) return '📖';
                    return '📚';
                }
                strands.forEach(s => { %>
                    <option value="<%= s %>" <%= selectedStrand === s ? 'selected' : '' %>><%= getStrandIcon(s) %> <%= s %></option>
                <% }); %>
            </select>
        </div>
        <div id="leaderboardTable">
        <% 
        var youRank = null, youEntry = null;
        // Find user's rank in the full leaderboard
        if (typeof userNickname !== 'undefined' && userNickname) {
            for (let i = 0; i < leaderboard.length; i++) {
                if (leaderboard[i].nickname === userNickname) {
                    youRank = i + 1;
                    youEntry = leaderboard[i];
                    break;
                }
            }
        }
        %>
        <% if (leaderboard.length === 0) { %>
            <div class="py-12 text-lg text-center text-gray-400">
                📊 No exam results yet. Be the first to take the exam!
            </div>
        <% } else { %>
            <!-- Mobile Card Layout -->
            <div class="space-y-3 md:hidden">
                <% leaderboard.slice(0, 10).forEach((entry, index) => {
                    const rank = index + 1;
                    let bgClass = 'bg-[#1e293b]';
                    let borderClass = '';
                    let crown = '';
                    const isUser = (typeof userNickname !== 'undefined' && userNickname && entry.nickname === userNickname);
                    
                    if (rank === 1) { bgClass = 'bg-yellow-900/40'; borderClass = 'border-2 border-yellow-400'; crown = '👑 '; }
                    else if (rank === 2) { bgClass = 'bg-gray-700/40'; borderClass = 'border-2 border-gray-400'; crown = '🥈 '; }
                    else if (rank === 3) { bgClass = 'bg-orange-900/40'; borderClass = 'border-2 border-orange-400'; crown = '🥉 '; }
                    
                    // If user is in top 10, highlight with border
                    if (isUser && rank > 3) {
                        borderClass = 'border-2 border-teal-400';
                    }
                    
                    let dateStr = '';
                    if (entry.date_taken) {
                        const d = new Date(entry.date_taken);
                        const options = { year: 'numeric', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true };
                        dateStr = d.toLocaleString('en-US', options);
                    }
                %>
                <div class="<%= bgClass %> <%= borderClass %> rounded-xl p-4">
                    <div class="flex items-center justify-between mb-2">
                        <div class="text-lg font-bold text-white"><%= crown %>#<%= rank %> <%= entry.nickname %><% if (isUser) { %> <span class="text-teal-400">(You)</span><% } %></div>
                        <div class="text-xl font-bold text-teal-400"><%= entry.score %>/10</div>
                    </div>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-[#232b36] text-teal-400"><%= entry.strand %></span>
                        <span class="text-sm text-amber-400">&#x23F1; <%= Math.floor(entry.time_taken / 60) %>:<%= (entry.time_taken % 60).toString().padStart(2, '0') %></span>
                    </div>
                    <% if (entry.date_taken) { %>
                        <div class="text-xs text-gray-400"><%= dateStr %></div>
                    <% } %>
                </div>
                <% }); %>
                <% if (youRank && youRank > 10 && youEntry) { %>
                <!-- Spacing -->
                <div class="h-3"></div>
                <div class="bg-[#1e293b] border-2 border-teal-400 rounded-xl p-4">
                    <div class="flex items-center justify-between mb-2">
                        <div class="text-lg font-bold text-white">#<%= youRank %> <%= youEntry.nickname %> <span class="text-teal-400">(You)</span></div>
                        <div class="text-xl font-bold text-teal-400"><%= youEntry.score %>/10</div>
                    </div>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-[#232b36] text-teal-400"><%= youEntry.strand %></span>
                        <span class="text-sm text-amber-400">&#x23F1; <%= Math.floor(youEntry.time_taken / 60) %>:<%= (youEntry.time_taken % 60).toString().padStart(2, '0') %></span>
                    </div>
                    <% if (youEntry.date_taken) { %>
                        <div class="text-xs text-gray-400"><%= new Date(youEntry.date_taken).toLocaleString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true }) %></div>
                    <% } %>
                </div>
                <% } %>
            </div>
            <!-- Desktop Table Layout -->
            <div class="hidden overflow-x-auto md:block">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-gray-400">
                        <th class="py-2">#</th>
                        <th class="py-2">Player</th>
                        <th class="py-2">Strand</th>
                        <th class="py-2">Score</th>
                        <th class="py-2">Duration</th>
                        <th class="py-2">Date & Time Taken</th>
                    </tr>
                </thead>
                <tbody>
                    <% leaderboard.slice(0, 10).forEach((entry, index) => {
                        const rank = index + 1;
                        let rowClass = '';
                        let crown = '';
                        const isUser = (typeof userNickname !== 'undefined' && userNickname && entry.nickname === userNickname);
                        
                        if (rank === 1) { rowClass = 'bg-yellow-900/40 text-yellow-300'; crown = '👑'; }
                        else if (rank === 2) { rowClass = 'bg-gray-700/40 text-gray-200'; crown = '🥈'; }
                        else if (rank === 3) { rowClass = 'bg-orange-900/40 text-orange-300'; crown = '🥉'; }
                        else { rowClass = 'text-white'; }
                        
                        // Format date & time
                        let dateStr = '';
                        if (entry.date_taken) {
                            const d = new Date(entry.date_taken);
                            const options = { year: 'numeric', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true };
                            dateStr = d.toLocaleString('en-US', options);
                        }
                    %>
                    <tr class="rounded-xl <%= rowClass %> <%= isUser && rank > 3 ? 'ring-2 ring-teal-400' : '' %>">
                        <td class="py-3 font-bold text-start"><span class="mr-1"><%= crown %></span><%= rank %></td>
                        <td class="py-3 font-bold text-start"><%= entry.nickname %><% if (isUser) { %> <span class="font-bold text-teal-400">(You)</span><% } %></td>
                        <td class="py-3 text-start">
                            <span class="inline-block px-4 py-1 rounded-full font-semibold bg-[#1e293b] text-teal-400"><%= entry.strand %></span>
                        </td>
                        <td class="py-3 font-bold text-teal-400 text-start"><%= entry.score %>/10</td>
                        <td class="py-3 font-bold text-start text-amber-400"><span>&#x23F1;</span> <%= Math.floor(entry.time_taken / 60) %>:<%= (entry.time_taken % 60).toString().padStart(2, '0') %></td>
                        <td class="py-3 font-bold text-gray-300 text-start">
                           <% if (entry.date_taken) { %>
                                <%= new Date(entry.date_taken + 'Z').toLocaleString('en-US', {
                                    year: 'numeric',
                                    month: 'long',
                                    day: 'numeric',
                                    hour: 'numeric',
                                    minute: '2-digit',
                                    hour12: true,
                                    timeZone: 'Asia/Singapore'
                                }) %>
                            <% } %>
                        </td>
                    </tr>
                    <% }); %>
                    <% if (youRank && youRank > 10 && youEntry) { %>
                    <!-- Spacing Row -->
                    <tr><td colspan="6" class="py-2"></td></tr>
                    <tr class="border-2 border-teal-400 rounded-xl">
                        <td class="py-3 font-bold text-white text-start"><%= youRank %></td>
                        <td class="py-3 font-bold text-white text-start"><%= youEntry.nickname %> <span class="font-bold text-teal-400">(You)</span></td>
                        <td class="py-3 text-center">
                            <span class="inline-block px-4 py-1 rounded-full font-semibold bg-[#1e293b] text-teal-400"><%= youEntry.strand %></span>
                        </td>
                        <td class="py-3 font-bold text-teal-400 text-start"><%= youEntry.score %>/10</td>
                        <td class="py-3 font-bold text-start text-amber-400"><span>&#x23F1;</span> <%= Math.floor(youEntry.time_taken / 60) %>:<%= (youEntry.time_taken % 60).toString().padStart(2, '0') %></td>
                        <td class="py-3 font-bold text-gray-300 text-start">
                            <% if (entry.date_taken) { %>
                                <%= new Date(entry.date_taken + 'Z').toLocaleString('en-US', {
                                    year: 'numeric',
                                    month: 'long',
                                    day: 'numeric',
                                    hour: 'numeric',
                                    minute: '2-digit',
                                    hour12: true,
                                    timeZone: 'Asia/Singapore'
                                }) %>
                            <% } %>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
            </div>
        <% } %>
        </div>
        <div class="flex flex-col justify-center gap-3 mt-6 sm:flex-row md:gap-4 md:mt-8">
            <a href="/exam/<%= subject %>" class="bg-teal-400 text-[#181f27] font-bold px-6 py-3 rounded-full transition hover:bg-teal-300 text-center">Take Exam</a>
            <a href="/exam" class="bg-teal-400 text-[#181f27] font-bold px-6 py-3 rounded-full transition hover:bg-teal-300 text-center">Home</a>
        </div>
    </div>
    <script>
        const userNickname = '<%= typeof userNickname !== "undefined" ? userNickname : "" %>';
        
        // AJAX strand filter (select)
        document.getElementById('strandSelect').addEventListener('change', function() {
            const strand = this.value;
            fetch(`/api/leaderboard/<%= subject %>?strand=${encodeURIComponent(strand)}`)
                .then(res => res.json())
                .then(data => {
                    if (!data.success) return;
                    const leaderboard = data.leaderboard;
                    let html = '';
                    if (!leaderboard || leaderboard.length === 0) {
                        html = '<div class="py-12 text-lg text-center text-gray-400">📊 No exam results yet. Be the first to take the exam!</div>';
                    } else {
                        let youRank = null, youEntry = null;
                        
                        // Find user's rank in the full leaderboard FIRST
                        if (userNickname) {
                            for (let i = 0; i < leaderboard.length; i++) {
                                if (leaderboard[i].nickname === userNickname) {
                                    youRank = i + 1;
                                    youEntry = leaderboard[i];
                                    break;
                                }
                            }
                        }
                        
                        // Mobile card layout
                        html += '<div class="space-y-3 md:hidden">';
                        leaderboard.slice(0, 10).forEach((entry, index) => {
                            const rank = index + 1;
                            let bgClass = 'bg-[#1e293b]';
                            let borderClass = '';
                            let crown = '';
                            const isUser = (userNickname && entry.nickname === userNickname);
                            
                            if (rank === 1) { bgClass = 'bg-yellow-900/40'; borderClass = 'border-2 border-yellow-400'; crown = '👑 '; }
                            else if (rank === 2) { bgClass = 'bg-gray-700/40'; borderClass = 'border-2 border-gray-400'; crown = '🥈 '; }
                            else if (rank === 3) { bgClass = 'bg-orange-900/40'; borderClass = 'border-2 border-orange-400'; crown = '🥉 '; }
                            
                            if (isUser && rank > 3) {
                                borderClass = 'border-2 border-teal-400';
                            }
                            
                            let dateStr = '';
                            if (entry.date_taken) {
                                const d = new Date(entry.date_taken);
                                const options = { year: 'numeric', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true };
                                dateStr = d.toLocaleString('en-US', options);
                            }
                            html += `<div class="${bgClass} ${borderClass} rounded-xl p-4">`;
                            html += `<div class="flex items-center justify-between mb-2">`;
                            html += `<div class="text-lg font-bold text-white">${crown}#${rank} ${entry.nickname}${isUser ? ' <span class="text-teal-400">(You)</span>' : ''}</div>`;
                            html += `<div class="text-xl font-bold text-teal-400">${entry.score}/10</div>`;
                            html += `</div>`;
                            html += `<div class="flex items-center gap-2 mb-2">`;
                            html += `<span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-[#232b36] text-teal-400">${entry.strand}</span>`;
                            html += `<span class="text-sm text-amber-400">&#x23F1; ${Math.floor(entry.time_taken / 60)}:${(entry.time_taken % 60).toString().padStart(2, '0')}</span>`;
                            html += `</div>`;
                            if (dateStr) {
                                html += `<div class="text-xs text-gray-400">${dateStr}</div>`;
                            }
                            html += `</div>`;
                        });
                        
                        if (youRank && youRank > 10 && youEntry) {
                            html += '<div class="h-3"></div>';
                            const dateStr = youEntry.date_taken ? new Date(youEntry.date_taken).toLocaleString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true }) : '';
                            html += `<div class="bg-[#1e293b] border-2 border-teal-400 rounded-xl p-4">`;
                            html += `<div class="flex items-center justify-between mb-2">`;
                            html += `<div class="text-lg font-bold text-white">#${youRank} ${youEntry.nickname} <span class="text-teal-400">(You)</span></div>`;
                            html += `<div class="text-xl font-bold text-teal-400">${youEntry.score}/10</div>`;
                            html += `</div>`;
                            html += `<div class="flex items-center gap-2 mb-2">`;
                            html += `<span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-[#232b36] text-teal-400">${youEntry.strand}</span>`;
                            html += `<span class="text-sm text-amber-400">&#x23F1; ${Math.floor(youEntry.time_taken / 60)}:${(youEntry.time_taken % 60).toString().padStart(2, '0')}</span>`;
                            html += `</div>`;
                            if (dateStr) {
                                html += `<div class="text-xs text-gray-400">${dateStr}</div>`;
                            }
                            html += `</div>`;
                        }
                        
                        html += '</div>';
                        
                        // Desktop table layout
                        html += '<div class="hidden overflow-x-auto md:block">';
                        html += '<table class="w-full text-sm"><thead><tr class="text-left text-gray-400"><th class="py-2">#</th><th class="py-2">Player</th><th class="py-2">Strand</th><th class="py-2">Score</th><th class="py-2">Duration</th><th class="py-2">Date & Time Taken</th></tr></thead><tbody>';
                        leaderboard.slice(0, 10).forEach((entry, index) => {
                            const rank = index + 1;
                            let rowClass = '';
                            let crown = '';
                            const isUser = (userNickname && entry.nickname === userNickname);
                            
                            if (rank === 1) { rowClass = 'bg-yellow-900/40 text-yellow-300'; crown = '👑'; }
                            else if (rank === 2) { rowClass = 'bg-gray-700/40 text-gray-200'; crown = '🥈'; }
                            else if (rank === 3) { rowClass = 'bg-orange-900/40 text-orange-300'; crown = '🥉'; }
                            else { rowClass = 'text-white'; }
                            
                            const ringClass = (isUser && rank > 3) ? 'ring-2 ring-teal-400' : '';
                            
                            let dateStr = '';
                            if (entry.date_taken) {
    const d = new Date(entry.date_taken);
    // d.setHours(d.getHours() + 8); // add Asia/Singapore offset

    const options = {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
        hour12: true
    };

    dateStr = d.toLocaleString('en-US', options);
}

                            html += `<tr class="rounded-xl ${rowClass} ${ringClass}"><td class="py-3 font-bold text-start"><span class="mr-1">${crown}</span>${rank}</td><td class="py-3 font-bold text-start">${entry.nickname}${isUser ? ' <span class="font-bold text-teal-400">(You)</span>' : ''}</td><td class="py-3 text-start"><span class="inline-block px-4 py-1 rounded-full font-semibold bg-[#1e293b] text-teal-400">${entry.strand}</span></td><td class="py-3 font-bold text-teal-400 text-start">${entry.score}/10</td><td class="py-3 font-bold text-start text-amber-400"><span>&#x23F1;</span> ${Math.floor(entry.time_taken / 60)}:${(entry.time_taken % 60).toString().padStart(2, '0')}</td><td class="py-3 font-bold text-gray-300 text-start">${dateStr}</td></tr>`;
                        });
                        
                        if (youRank && youRank > 10 && youEntry) {
                            const dateStr = youEntry.date_taken ? new Date(youEntry.date_taken).toLocaleString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true }) : '';
                            html += `<tr><td colspan="6" class="py-2"></td></tr>`;
                            html += `<tr class="border-2 border-teal-400 rounded-xl"><td class="py-3 font-bold text-white text-start">${youRank}</td><td class="py-3 font-bold text-white text-start">${youEntry.nickname} <span class="font-bold text-teal-400">(You)</span></td><td class="py-3 text-center"><span class="inline-block px-4 py-1 rounded-full font-semibold bg-[#1e293b] text-teal-400">${youEntry.strand}</span></td><td class="py-3 font-bold text-teal-400 text-start">${youEntry.score}/10</td><td class="py-3 font-bold text-start text-amber-400"><span>&#x23F1;</span> ${Math.floor(youEntry.time_taken / 60)}:${(youEntry.time_taken % 60).toString().padStart(2, '0')}</td><td class="py-3 font-bold text-gray-300 text-start">${dateStr}</td></tr>`;
                        }
                        
                        html += '</tbody></table></div>';
                    }
                    document.getElementById('leaderboardTable').innerHTML = html;
                });
        });
    </script>
</body>
</html>
