<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= data.title %></title>
  <link rel="stylesheet" href="/css/styles.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="icon" type="image/png" href="/favicon.png">
</head>

<body class="flex flex-col items-center justify-center min-h-screen p-4 bg-slate-100 sm:p-6">

  <!-- Go Back Button -->
  <div class="w-full max-w-3xl mb-4 flex justify-start">
    <a href="/" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-slate-600 transition-all bg-white border border-slate-200 shadow-sm rounded-xl hover:text-slate-900 hover:bg-slate-50 active:scale-95">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Home
    </a>
  </div>

  <div class="w-full max-w-3xl overflow-hidden bg-white shadow-xl rounded-2xl sm:rounded-3xl">

    <!-- Header -->

    <div class="flex flex-col gap-3 px-4 py-5 border-b sm:flex-row sm:items-center sm:gap-4 sm:px-8 sm:py-6 border-slate-200">
      <div class="flex items-center justify-center flex-shrink-0 w-12 h-12 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-blue-500/10">
        <div class="flex items-center justify-center text-lg text-white bg-blue-500 rounded-lg w-9 h-9 sm:w-11 sm:h-11 sm:rounded-xl sm:text-xl">
          📁
        </div>
      </div>

      <div class="flex-1 min-w-0">
        <h1 class="text-xl font-bold leading-tight truncate sm:text-2xl text-slate-900"><%= data.title %></h1>
        <p class="mt-1 text-xs leading-snug sm:text-sm text-slate-500"><%= data.description %></p>
      </div>

      <!-- Exam Button: below on mobile, inline on desktop -->
      <!-- <div class="flex-shrink-0 w-full mt-4 sm:mt-0 sm:ml-4 sm:w-auto">
        <a href="/exam/" class="block w-full sm:w-auto bg-teal-400 text-[#181f27] font-bold px-6 py-3 rounded-full transition duration-200 ease-in-out hover:bg-teal-300 hover:scale-105 hover:shadow-lg text-center text-base sm:text-lg shadow-md focus:outline-none focus:ring-2 focus:ring-teal-400">Take Exam</a>
      </div> -->
    </div>

    <!-- Accordion -->
    <div class="p-4 space-y-4 sm:p-6">

      <% data.files.forEach((file, i) => { %>
      <div class="overflow-hidden border shadow-sm rounded-xl sm:rounded-2xl">

        <!-- Accordion Header -->
        <button
          type="button"
          class="w-full flex items-center justify-between gap-3 sm:gap-4 p-4 sm:p-5 bg-slate-50 hover:bg-blue-50 transition-all duration-300 hover:-translate-y-0.5"
          onclick="toggleAccordion(<%= i %>)"
        >
          <div class="flex items-start min-w-0 gap-3 sm:gap-4">

            <div class="flex items-center justify-center flex-shrink-0 w-10 h-10 rounded-lg sm:w-12 sm:h-12 sm:rounded-xl bg-blue-500/10">
              <span class="text-xl text-blue-500 sm:text-2xl">📘</span>
            </div>

            <div class="min-w-0 text-left">
              <h2 class="text-base font-semibold leading-tight sm:text-lg text-slate-900"><%= file.title %></h2>
              <p class="text-xs leading-snug sm:text-sm text-slate-500"><%= file.desc %></p>
            </div>
          </div>

          <span class="flex-shrink-0 text-lg sm:text-xl text-slate-500" id="icon-<%= i %>">+</span>
        </button>

        <!-- Accordion Content -->
        <div id="acc-<%= i %>" class="hidden bg-white border-t">
          <div class="p-3 space-y-2 sm:p-4">

            <% (file.items || []).forEach(item => { %>
            <a href="<%= item.link %>"
               class="flex items-center block gap-3 p-3 transition rounded-lg sm:rounded-xl bg-slate-100 hover:bg-blue-100 sm:gap-4"
               <%= item.type === 'pdf' ? 'download' : '' %>>
              <span class="text-lg text-blue-500 sm:text-xl"><%= item.type === 'pdf' ? '📄' : '🔗' %></span>
              <span class="text-sm font-medium text-slate-700 sm:text-base"><%= item.name %></span>
            </a>
            <% }) %>

          </div>
        </div>

      </div>
      <% }) %>

    </div>

    <!-- Footer -->
    <div class="py-4 text-xs text-center border-t sm:py-5 sm:text-sm text-slate-500">
      <b><%= data.files.length %> <%= data.files.length === 1 ? 'lesson ' : 'lessons ' %>available</b>
    </div>

  </div>

  <!-- Accordion JS -->
  <script>
    function toggleAccordion(index) {
      const section = document.getElementById(`acc-${index}`);
      const icon = document.getElementById(`icon-${index}`);

      if (!section || !icon) return;

      const isOpen = !section.classList.contains("hidden");

      if (isOpen) {
        section.classList.add("hidden");
        icon.textContent = "+";
      } else {
        section.classList.remove("hidden");
        icon.textContent = "−";
      }
    }
  </script>

</body>
</html>
