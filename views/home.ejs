<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Select Subject</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="/favicon.png">
</head>

<body class="flex items-center justify-center min-h-screen p-6 bg-slate-100">

  <div class="w-full max-w-4xl">
    <h1 class="mb-6 text-2xl font-bold text-center sm:text-3xl text-slate-900">
      Select a Subject
    </h1>

    <!-- CARD GRID -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6">

      <!-- PhysSci Card -->
      <a href="/physci"
         class="flex items-start gap-4 p-5 transition-all duration-300 bg-white border shadow-md sm:p-6 hover:shadow-xl hover:-translate-y-1 rounded-2xl border-slate-200">
        
        <div class="flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-xl bg-blue-500/10">
          <span class="text-2xl text-blue-500">🔬</span>
        </div>

        <div class="flex-1">
          <h2 class="mb-1 text-lg font-semibold sm:text-xl text-slate-900">
            Physical Science
          </h2>
          <p class="text-sm leading-snug text-slate-500">
            Modules, activities, and worksheets for Physical Science.
          </p>
        </div>
      </a>

      <!-- MIL Card -->
      <a href="/mil"
         class="flex items-start gap-4 p-5 transition-all duration-300 bg-white border shadow-md sm:p-6 hover:shadow-xl hover:-translate-y-1 rounded-2xl border-slate-200">
        
        <div class="flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-xl bg-purple-500/10">
          <span class="text-2xl text-purple-500">💡</span>
        </div>

        <div class="flex-1">
          <h2 class="mb-1 text-lg font-semibold sm:text-xl text-slate-900">
            Media & Information Literacy
          </h2>
          <p class="text-sm leading-snug text-slate-500">
            Learn about media, information literacy, and digital citizenship.
          </p>
        </div>
      </a>

      <!-- Add More Subjects Here -->
      <% if (typeof extraSubjects !== "undefined") { %>
        <% extraSubjects.forEach(subj => { %>
          <a href="/<%= subj.link %>"
             class="flex items-start gap-4 p-5 transition-all duration-300 bg-white border shadow-md sm:p-6 hover:shadow-xl hover:-translate-y-1 rounded-2xl border-slate-200">
            
            <div class="flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-xl bg-green-500/10">
              <span class="text-2xl text-green-500"><%= subj.icon %></span>
            </div>

            <div class="flex-1">
              <h2 class="mb-1 text-lg font-semibold sm:text-xl text-slate-900">
                <%= subj.title %>
              </h2>
              <p class="text-sm leading-snug text-slate-500">
                <%= subj.description %>
              </p>
            </div>
          </a>
        <% }) %>
      <% } %>

    </div>

  </div>

</body>
</html>
